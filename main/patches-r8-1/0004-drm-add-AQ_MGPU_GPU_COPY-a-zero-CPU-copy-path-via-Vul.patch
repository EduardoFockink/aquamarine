index c5dd9c3..2d9a052 100644
--- a/src/backend/drm/Renderer.cpp
+++ b/src/backend/drm/Renderer.cpp
@@ -954,6 +954,17 @@ GLuint CDRMRenderer::packFramebuffer(SP<IBuffer> from, const CRegion& region, bo
     return pack.fbo;
 }
 
+int CDRMRenderer::createNativeFenceFD() {
+    CEglContextGuard eglContext(*this);
+    EGLSyncKHR       sync = proc.eglCreateSyncKHR(egl.display, EGL_SYNC_NATIVE_FENCE_ANDROID, nullptr);
+    if (sync == EGL_NO_SYNC_KHR)
+        return -1;
+    glFlush(); // otherwise the fd may not be valid yet
+    const int fd = proc.eglDupNativeFenceFDANDROID(egl.display, sync);
+    proc.eglDestroySyncKHR(egl.display, sync);
+    return fd == EGL_NO_NATIVE_FENCE_FD_ANDROID ? -1 : fd;
+}
+
 void CDRMRenderer::waitForGpuAsleep() {
     EGLSyncKHR sync = proc.eglCreateSyncKHR(egl.display, EGL_SYNC_NATIVE_FENCE_ANDROID, nullptr);
     if (sync == EGL_NO_SYNC_KHR) {
diff --git a/src/backend/drm/Renderer.hpp b/src/backend/drm/Renderer.hpp
index 97474a7..f68c0f8 100644
--- a/src/backend/drm/Renderer.hpp
+++ b/src/backend/drm/Renderer.hpp
@@ -125,6 +125,9 @@ namespace Aquamarine {
         // Used by AQ_MGPU_CPU_COPY so the secondary GPU never reads (or renders from) the primary's buffers.
         bool readRegionInto(Hyprutils::Memory::CSharedPointer<IBuffer> from, uint8_t* dst, uint32_t dstStride, eCpuCopyLayout layout, const Hyprutils::Math::CRegion& region,
                             int waitFD = -1);
