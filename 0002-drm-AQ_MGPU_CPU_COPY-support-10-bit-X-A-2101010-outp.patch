diff --git a/src/backend/drm/Renderer.cpp b/src/backend/drm/Renderer.cpp
index bb9ea75..1ade79a 100644
--- a/src/backend/drm/Renderer.cpp
+++ b/src/backend/drm/Renderer.cpp
@@ -824,7 +824,117 @@ void CDRMRenderer::readBuffer(Hyprutils::Memory::CSharedPointer<IBuffer> buf, st
