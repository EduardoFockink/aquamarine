+        GLuint                                                readFramebuffer(Hyprutils::Memory::CSharedPointer<IBuffer> buf);
         bool                                                  verifyDestinationDMABUF(const SDMABUFAttrs& attrs);
         void                                                  waitOnSync(int fd);
         int                                                   recreateBlitSync();
